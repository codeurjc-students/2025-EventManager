# Database Configuration - Entorno Local
DB_URL=jdbc:postgresql://localhost:9999/bd_event_manager
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# MinIO Configuration (Para desarrollo local)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=dev-user
MINIO_SECRET_KEY=dev-password
MINIO_BUCKET_NAME=event-manager-images

# AWS Configuration (Para producción)
APP_IMAGE=region.ocir.io/<tenancy>/<repo>/eventmanagerapp
RDS_ENDPOINT=jdbc:postgresql://your-rds-endpoint.amazonaws.com:5432/bd_event_manager
RDS_USERNAME=your_rds_username
RDS_PASSWORD=your_rds_password
S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=eu-west-1

# TLS Configuration (Spring Boot - AWS)
SSL_KEYSTORE_PATH=/opt/eventmanager/certs/eventmanager.p12
SSL_KEYSTORE_PASSWORD=your_keystore_password
SSL_KEY_ALIAS=tomcat
SSL_KEY_PASSWORD=your_key_password
